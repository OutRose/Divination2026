# Divination2026 — line-ending and binary policy
# Established in phase α-1 (2026-06-28). See CLAUDE.md §2 for context.

# Source, project files, documentation and tooling: UTF-8 without BOM, LF.
* text=auto eol=lf

# ---- Binary: never normalize ----
*.snk     binary
*.pfx     binary
*.exe     binary
*.dll     binary
*.pdb     binary
*.suo     binary
*.vsidx   binary
*.nupkg   binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.bmp     binary
*.zip     binary
*.7z      binary
*.cache   binary
